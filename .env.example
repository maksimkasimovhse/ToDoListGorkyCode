APP_PORT=8080
POSTGRES_PORT=55432
POSTGRES_PASSWORD=gorky
REDIS_PORT=6379
ML_REQUEST_STREAM=planner:ml:requests
ML_RESULT_STREAM=planner:ml:results
ML_RESULT_GROUP=planner-backend
MESSAGE_TIMEOUT=90s
ML_REQUEST_GROUP=planner-ml

# Задайте один из двух секретов. Значение из XLSX сюда не коммитить.
GIGACHAT_AUTH_KEY=
GIGACHAT_ACCESS_TOKEN=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_EMBEDDING_MODEL=Embeddings-2

SESSION_TTL=168h

# Бот MAX (max-bot/README.md): общий секрет бота и бэкенда, не короче 32 символов
BOT_SERVICE_TOKEN=
# Ссылка на бота, например https://max.ru/my_planner_bot — для кнопки «Подключить MAX» на сайте
MAX_BOT_URL=
